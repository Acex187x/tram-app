EXPO_PUBLIC_MAPBOX_KEY=
# The self-hosted Convex deployment (must equal CONVEX_CLOUD_ORIGIN in
# self-hosted/.env — the sync handshake rejects any other URL).
EXPO_PUBLIC_CONVEX_URL=https://tram-api.acex.sh
# The backend's HTTP-actions origin (CONVEX_SITE_ORIGIN) — trip geometry is
# served from here; defaults to the production URL when unset.
EXPO_PUBLIC_CONVEX_SITE_URL=https://tram-site.acex.sh

# NO GOLEMIO CREDENTIALS: the app makes no direct Golemio requests (client.ts
# USE_BACKEND_PROXY). The key lives server-side only:
#   npx convex env set GOLEMIO_KEY "<jwt>"
