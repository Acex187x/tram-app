new file mode 100644
index 0000000..1cf404e
--- /dev/null
+++ b/node_modules/@rnmapbox/maps/ios/RNMBX/RNMBXShapeUpdateGate.h
@@ -0,0 +1,41 @@
+#pragma once
+#ifdef __cplusplus
+#include <cstdint>
+#include <mutex>
+#include <unordered_map>
+
+namespace rnmbx {
+// Registered before view resolution. A delayed lookup must never replay an
+// old shape after a newer request for the same view has been accepted.
+class ShapeUpdateGate {
+ public:
+  uint64_t begin(int64_t view) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const auto token = ++sequence_;
+    pending_[view] = token;
+    return token;
+  }
+  bool isCurrent(int64_t view, uint64_t token) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const auto found = pending_.find(view);
+    return found != pending_.end() && found->second == token;
+  }
+  bool consume(int64_t view, uint64_t token) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const auto found = pending_.find(view);
+    if (found == pending_.end() || found->second != token) return false;
+    pending_.erase(found);
+    return true;
+  }
+  size_t size() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return pending_.size();
+  }
+ private:
+  std::mutex mutex_;
+  uint64_t sequence_ = 0;
+  std::unordered_map<int64_t, uint64_t> pending_;
+};
+}
+
+#endif // __cplusplus: CocoaPods also imports public headers from Objective-C/Swift.
