# Copy to self-hosted/.env and fill in. Git-ignored — it holds the instance secret.
#
#   openssl rand -hex 32     → INSTANCE_SECRET

# Deployment identity. INSTANCE_SECRET derives every admin key; rotating it
# invalidates all of them (and the CLI credentials in ../.env.local).
INSTANCE_NAME=tram-spotter
INSTANCE_SECRET=

# Where published ports land: loopback for the Convex CLI on this host.
# Internet traffic comes through the Dokploy Traefik edge over dokploy-network,
# never through a published port. Never set this to 0.0.0.0.
BIND_ADDR=127.0.0.1

PORT=3210
SITE_PROXY_PORT=3211
DASHBOARD_PORT=6791

# The origins handed to clients. CONVEX_CLOUD_ORIGIN must be byte-identical to
# EXPO_PUBLIC_CONVEX_URL in the app's .env, or the sync handshake is rejected.
CONVEX_CLOUD_ORIGIN=https://tram-api.acex.sh
CONVEX_SITE_ORIGIN=https://tram-site.acex.sh

# Pin instead of :latest once the deployment is real (see the image tags at
# ghcr.io/get-convex/convex-backend). Backend and dashboard move together.
# CONVEX_REV=
